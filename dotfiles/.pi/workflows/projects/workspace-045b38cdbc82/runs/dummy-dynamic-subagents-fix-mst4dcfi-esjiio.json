  "script": "export const meta = { name: 'dummy_dynamic_subagents_fix', description: 'Dynamic fan-out dummy tasks; rely on default model/provider to avoid batch-only model errors.' };\n\nconst agentNames = ['worker','scout','reviewer','planner','demo-scout','demo-deep-scout','demo-plan','demo-orchestrator','btw-agent'];\nconst count = (args?.count ?? 7);\nconst thinkingLevel = (args?.thinkingLevel ?? 'low');\n\nconst makePrompt = (i) => {\n  const sleepish = (i % 2 === 1);\n  if (sleepish) {\n    return `Task ${i}: Sleep 10 seconds (or simulate sleep), then respond exactly: HELLO_FROM_TASK_${i} DONE`;\n  }\n  return `Task ${i}: Respond exactly: HELLO_FROM_TASK_${i} DONE`;\n};\n\nconst tasks = Array.from({ length: count }, (_, i) => ({\n  idx: i,\n  agentName: agentNames[i % agentNames.length],\n  prompt: makePrompt(i),\n}));\n\nconst results = await parallel(\n  tasks.map(t => () => agent(t.prompt, { agent: t.agentName, thinkingLevel }))\n);\n\nreturn results;",
