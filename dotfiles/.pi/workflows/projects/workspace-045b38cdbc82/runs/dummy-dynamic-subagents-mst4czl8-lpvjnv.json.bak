{
  "runId": "dummy-dynamic-subagents-mst4czl8-lpvjnv",
  "workflowName": "dummy_dynamic_subagents",
  "script": "export const meta = { name: 'dummy_dynamic_subagents', description: 'Dynamically fan out dummy hello tasks across available pi subagents.' };\n\nconst agentNames = [\n  'worker',\n  'scout',\n  'reviewer',\n  'planner',\n  'demo-scout',\n  'demo-deep-scout',\n  'demo-plan',\n  'demo-orchestrator',\n  'btw-agent',\n];\n\nconst count = (args?.count ?? 7);\nconst model = (args?.model ?? 'gpt-5.4-nano');\nconst thinkingLevel = (args?.thinkingLevel ?? 'low');\n\nconst makePrompt = (i) => {\n  // Ensure each run is distinguishable in the output.\n  const sleepish = (i % 2 === 1);\n  if (sleepish) {\n    return `Task #${i}: Sleep for 10 seconds (or simulate sleep), then say: HELLO_FROM_TASK_${i}. End with DONE.`;\n  }\n  return `Task #${i}: Just say HELLO_FROM_TASK_${i}, then DONE.`;\n};\n\nconst tasks = Array.from({ length: count }, (_, i) => ({\n  idx: i,\n  agentName: agentNames[i % agentNames.length],\n  prompt: makePrompt(i),\n}));\n\nconst results = await parallel(\n  tasks.map(t => () => agent(t.prompt, { agent: t.agentName, model, thinkingLevel }))\n);\n\nlog(`Completed ${count} dummy subagent tasks.`);\nreturn results;",
  "args": {
    "count": 9,
    "thinkingLevel": "low",
    "model": "gpt-5.4-nano"
  },
